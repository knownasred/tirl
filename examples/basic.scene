Camera "Camera" {
    lookFrom: Point3(0, 0, 0),
    lookAt: Point3(0, 0, -1),
    vup: Point3(0, 1, 0),
    vfov: 90,
    aspectRatio: 1.77,
    imageWidth: 400,
    samplesPerPixel: 100,
    maxDepth: 50,
    defocusAngle: 4,
    focusDistance: 1,
}

LambertianMaterial "Ground" {
    albedo: Color3(0.8, 0.8, 0.0),
}

LambertianMaterial "Center" {
    albedo: Color3(0.1, 0.2, 0.5),
}

DielectricMaterial "Glass" {
    refractionIndex: 1.50,
}

DielectricMaterial "Bubble" {
    refractionIndex: 0.6667,
}

MetalMaterial "Copper" {
    albedo: Color3(0.8, 0.6, 0.2),
    fuzz: 1.0,
}

Sphere "ground" {
    position: Point3(0, -100.5, -1),
    radius: 100,
    material: @"Ground",
}

Sphere "center" {
    position: Point3(0, 0, -1.2),
    radius: 0.5,
    material: @"Center",
}

Sphere "left" {
    position: Point3(-1, 0, -1),
    radius: 0.5,
    material: @"Glass",
}

Sphere "bubble" {
    position: Point3(-1, 0, -1),
    radius: 0.4,
    material: @"Bubble",
}

Sphere "right" {
    position: Point3(1, 0, -1),
    radius: 0.5,
    material: @"Copper",
}
